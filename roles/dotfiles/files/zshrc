# vim: tw=0

# do nothing for noninteractive environments
[[ -o interactive ]] || return

# util func
function _has_command {
    (( $+commands[$1] ))
}

### choose editor & pager
if _has_command vim; then
    export EDITOR=vim
elif _has_command vi; then
    export EDITOR=vi
else
    echo 'Vi/Vim not found, EDITOR not set'
fi
if _has_command less; then
    export PAGER=less
else
    export PAGER=more
fi

# Vi mode & emacs-style clear/history-search using fzf
bindkey -v
bindkey -M viins '^L' clear-screen

# zsh completion
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

# colors for ls & completion:
if _has_command dircolors; then
    eval "$(dircolors -b)"
fi
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}

# local binary dir
path+=("$HOME/.local/bin")
typeset -U path
export PATH

# cd straight to code
export CDPATH=$HOME/code

# history options
HISTSIZE=9000
SAVEHIST=$HISTSIZE
HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
setopt hist_ignore_space
setopt hist_ignore_dups
setopt no_nomatch

# prompt
_dschep_prompt_userhost=''
if [[ -n "$SSH_CONNECTION" || "$EUID" -eq 0 ]] || { [[ -r /proc/1/cgroup ]] && grep -q docker /proc/1/cgroup 2>/dev/null; }; then
    _dschep_prompt_userhost='%n@%m'
fi
setopt prompt_subst
autoload -Uz vcs_info
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git:*' check-for-changes true
zstyle ':vcs_info:git:*' stagedstr '%F{magenta}'
zstyle ':vcs_info:git:*' unstagedstr '%F{magenta}'
zstyle ':vcs_info:git:*' formats ' %F{green}%c%u%b%f'
zstyle ':vcs_info:git:*' actionformats ' %F{magenta}%b|%a%f'
function dschep_prompt_command {
    print -Pn "\e]0;%n@%m:%~\a"
    vcs_info
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd dschep_prompt_command
PROMPT='[%(!.%F{red}.%F{green})${_dschep_prompt_userhost}:%f%B%1~%b]${vcs_info_msg_0_}%F{magenta}%(?.. %?)%f %B%#%b '

## tmux layout
function vimux {
    if [[ "$TMUX" == "" ]]; then
        tmux new-session -d
    fi
    local ratio
    local window_name
    ratio=50
    if [[ "$1" != "" ]]; then
        ratio=33
    fi
    window_name=$(basename $PWD)
    tmux rename-window "$window_name"
    tmux split-window -hb -p $ratio vim
    tmux select-pane -t 2
    if [[ "$1" != "" ]]; then
        tmux split-window -h -p 50 $1
    fi
    tmux select-pane -t 2
    tmux split-window -v -p 50
    tmux select-pane -t 1
    if [[ "$TMUX" == "" ]]; then
        tmux attach
    fi
}

# load local extensions to zshrc
if [[ -f ~/.zshrc.local_ext ]]; then
    . ~/.zshrc.local_ext
fi

# Setup shell-integrated software
if _has_command fnm ; then
    eval "$(fnm env --shell zsh)"
fi
if [[ -f "$HOME/.cargo/env" ]]; then
    . "$HOME/.cargo/env"
fi
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
if _has_command fzf; then
  eval "$(fzf --zsh)"
  export FZF_DEFAULT_OPTS=$'--color=fg:#ebdbb2,bg:#282828,hl:#fabd2f,fg+:#ebdbb2,bg+:#3c3836
  --color=hl+:#fabd2f,info:#83a598,prompt:#bdae93,pointer:#83a598
  --color=marker:#a8c4b9,spinner:#fabd2f,header:#a89984,border:#504945
  --color=gutter:#3c3836'
else
  bindkey -M viins '^R' history-incremental-search-backward
fi

# date utilities
alias today='date +%F'
alias now="date +%FT%T"

# default behaviors
alias grep='grep --color=auto'
alias df='df -h'
if command ls --version 2> /dev/null | grep GNU > /dev/null; then
    alias ls='ls --indicator-style=slash --human-readable --ignore-backups --color=auto --time-style=long-iso'
else
    alias ls='ls -p -h -G'
fi

#common mistakes
alias cd..='cd ..'

#short cuts
alias ll='ls -l'
alias la='ls -la'

## docker-compose shortcuts
function dc {
  docker compose "$@"
}
function dcr {
    dc run --rm "$@"
}

# stupid new docker compose
export COMPOSE_MENU=false
