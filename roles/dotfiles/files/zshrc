# vim: tw=0

# do nothing for noninteractive environments
[[ -o interactive ]] || return

function _has_command {
    (( $+commands[$1] ))
}

###choose editor
if _has_command vim; then
    export EDITOR=vim
elif _has_command vi; then
    export EDITOR=vi
else
    echo 'Vi/Vim not found, EDITOR not set'
fi

###choose pager
if _has_command less; then
    export PAGER=less
else
    export PAGER=more
fi

###ubuntu calls ack ack-grep
if _has_command ack-grep; then
    alias ack=ack-grep
fi

#### gnome 256 colors
if [[ "$COLORTERM" == "gnome-terminal" ]]; then
    export TERM="xterm-256color"
fi

#### Vi mode & emacs-style clear
bindkey -v
bindkey -M viins '^L' clear-screen
bindkey -M viins '^R' history-incremental-search-backward

#### zsh completion
autoload -Uz compinit
compinit

#for ls:
if _has_command dircolors; then
    eval "$(dircolors -b)"
fi

#date utilities
alias today='date +%F'
alias now="date +%FT%T"

#.env utility
alias dotenv='eval $(sed -e "s/^/export /" .env|tr "\n" ";")'

#default behaviours
alias grep='grep --color=auto'
alias df='df -h'
if command ls --version 2> /dev/null | grep GNU > /dev/null; then
    alias ls='ls --indicator-style=slash --human-readable --ignore-backups --color=auto --time-style=long-iso'
else
    alias ls='ls -p -h -G'
fi

#common mistakes
alias cd..='cd ..'

#short cuts
alias ll='ls -l'
alias la='ls -la'

if _has_command dtrx; then
    alias x=dtrx
else
    alias x='tar xvf'
fi

# simple way to do reverse ssh tunnels
function rssh-proxy () {
    local host=${2%:*}
    local rport=${2#*:}
    ssh -R 0.0.0.0:$rport:127.0.0.1:$1 $host "echo tunnel available at $2&&cat"
}

## docker-compose shortcuts
function dc {
  local compose_file
  compose_file=$(sed -ne 's/^COMPOSE_FILE=//p' .env)

  if [[ -z "${compose_file}" ]]; then
    docker compose "$@"
  else
    docker compose -f "${compose_file}" "$@"
  fi
}
function dcswap {
    sed -i '' -e "s/^COMPOSE_FILE=.*/COMPOSE_FILE=$1/" .env
}
function dcr {
    dc run --rm "$@"
}

