## tmux layouts
function vimux {
    if [[ "$TMUX" != "" ]]; then
        local window_name
        window_name=$(basename $PWD)
        tmux rename-window "$window_name"
        if [[ "$VIM_CLIENT_SERVER_SUPPORT" = t ]]; then
            tmux split-window -hb -p 50 vim --servername "$window_name"
        else
            tmux split-window -hb -p 50 vim
        fi
        tmux select-pane -t 2
        tmux split-window -v -p 50
        tmux select-pane -t 1
    else
        echo "this function must be run from a shell inside of a tmux session"
    fi
}
function vimuxai {
    if [[ "$TMUX" != "" ]]; then
        local window_name
        window_name=$(basename $PWD)
        tmux rename-window "$window_name"
        if [[ "$VIM_CLIENT_SERVER_SUPPORT" = t ]]; then
            tmux split-window -hb -p 33 vim --servername "$window_name"
        else
            tmux split-window -hb -p 33 vim
        fi
        tmux select-pane -t 2
        tmux split-window -h -p 50 claude
        tmux select-pane -t 2
        tmux split-window -vb -p 50
        tmux select-pane -t 1
    else
        echo "this function must be run from a shell inside of a tmux session"
    fi
}
## vim-tmux shortcut
function vmux {
    local window_name
    window_name=$(basename $PWD)
    vim --servername "$window_name" --remote "$@"
    tmux list-panes -F "#{pane_index} #{pane_current_command}" | grep -Ei "vim" | awk '{print $1}' | xargs -I % tmux select-pane -t %
}
function vmux-send {
    local window_name
    window_name=$(basename $PWD)
    vim --servername "$window_name" --remote-send "$@"
    tmux list-panes -F "#{pane_index} #{pane_current_command}" | grep -Ei "vim" | awk '{print $1}' | xargs -I % tmux select-pane -t %
}

