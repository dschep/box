# user basics
[user]
    name = Daniel Schep
    email = dschep@gmail.com
# sign with ssh
    signingkey = ~/.ssh/id_rsa
[commit]
    gpgsign = true
[gpg]
	format = ssh

# path-based configs
[includeIf "gitdir:~/code/onx/**"]
  path = ./.gitconfig-onx


# diff/meld config
[diff]
    tool = meld
[merge]
    tool = meld
[difftool]
    prompt = false
[mergetool]
    prompt = false

# aliases
[alias]
    stat = status -sb

# some defaults
[push]
    default = simple
    autoSetupRemote = true
[help]
    autocorrect = 10
[pull]
	rebase = false
[color]
    diff = auto
    status = auto
    branch = auto

# add a global gitignore
[core]
    excludesfile = ~/.gitignore


# @glyph said do this: https://web.archive.org/web/20210211200206/https://twitter.com/glyph/status/1359955841810530304
[protocol "http"]
allow = never
[protocol "git"]
allow = never
[fetch]
        fsckObjects = true
[transfer]
        fsckObjects = true
[receive]
        fsckObjects = true

# URL shortcuts
[url "git@github.com:"]
    insteadOf = github:
[url "git@github.com:"]
    insteadOf = gh:
[url "git@gitlab.com:"]
    insteadOf = gitlab:
[url "git@gitlab.com:"]
    insteadOf = gl:
[url "git@bitbucket.com:"]
    insteadOf = bitbucket:
[url "git@bitbucket.com:"]
    insteadOf = bb:
